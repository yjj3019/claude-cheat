# Copy this file to .env.local-llm and replace the URL and model ID.
# This requires an Anthropic-compatible /v1/messages API, not /v1/chat/completions.
LOCAL_LLM_URL=http://127.0.0.1:11434/v1/messages
LOCAL_LLM_MODEL=REPLACE_WITH_SERVER_MODEL_ID
# Local-only default. Remote hosts require explicit true and HTTPS.
LOCAL_LLM_ALLOW_REMOTE=false
# Optional; use a credential issued by this LLM server only.
# LOCAL_LLM_API_KEY=
# Optional model-list endpoint, same scheme/host/port as LOCAL_LLM_URL.
# Ollama can also use /api/tags here. No inference is sent by -CheckLocal.
# LOCAL_LLM_MODELS_URL=http://127.0.0.1:11434/v1/models
